<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_appointment_booking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.x" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="appointment-booking" name="Appointment Booking" isExecutable="true">
    <bpmn:startEvent id="Start_Booking" name="Booking requested">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_CheckSlot" name="Check slot">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Slot" name="Slot status?" default="Flow_Full">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_Avail</bpmn:outgoing>
      <bpmn:outgoing>Flow_Full</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_Booking" targetRef="Task_CheckSlot" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_CheckSlot" targetRef="Gateway_Slot" />
    <bpmn:sequenceFlow id="Flow_Avail" name="AVAILABLE" sourceRef="Gateway_Slot" targetRef="Task_BookSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotDecision.slotStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Full" name="FULL" sourceRef="Gateway_Slot" targetRef="Call_SlotFull" />
    <bpmn:scriptTask id="Task_BookSlot" name="Book slot">
      <bpmn:extensionElements>
        <zeebe:script expression="={status: &quot;BOOKED&quot;, department: department, slot: preferredSlot, bookedCount: bookedCount + 1}" resultVariable="booking" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Avail</bpmn:incoming>
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Task_BookSlot" targetRef="Call_Confirm" />
    <bpmn:callActivity id="Call_Confirm" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="recipientId" />
          <zeebe:input source="=&quot;Hello &quot; + patientName + &quot;, your &quot; + department + &quot; appointment for &quot; + preferredSlot + &quot; is confirmed.&quot;" target="messageText" />
          <zeebe:output source="=notificationSent" target="confirmationSent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Call_Confirm" targetRef="Task_Appointment" />
    <bpmn:userTask id="Task_Appointment" name="Appointment pending">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_Appointment" targetRef="End_Booked" />
    <bpmn:endEvent id="End_Booked" name="Appointment completed">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_SlotFull" name="Send slot-full notice">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="recipientId" />
          <zeebe:input source="=&quot;Sorry &quot; + patientName + &quot;, the &quot; + department + &quot; slot is full. &quot; + slotDecision.suggestedAction" target="messageText" />
          <zeebe:output source="=notificationSent" target="slotFullNotificationSent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Full</bpmn:incoming>
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Call_SlotFull" targetRef="End_Full" />
    <bpmn:endEvent id="End_Full" name="Slot full">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_Cancel" name="Handle cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Start_Cancel" name="Cancellation requested">
        <bpmn:outgoing>Flow_C1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MsgDef_Cancel" messageRef="Message_Cancel" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_Release" name="Release slot">
        <bpmn:extensionElements>
          <zeebe:script expression="={status: &quot;RELEASED&quot;, department: department, slot: preferredSlot, bookedCount: bookedCount - 1}" resultVariable="slotRelease" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C1</bpmn:incoming>
        <bpmn:outgoing>Flow_C2</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Cancel" targetRef="Task_Release" />
      <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_Release" targetRef="Call_Cancel" />
      <bpmn:callActivity id="Call_Cancel" name="Send cancellation notice">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="send-notification" propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=patientId" target="recipientId" />
            <zeebe:input source="=&quot;Hello &quot; + patientName + &quot;, your &quot; + department + &quot; appointment for &quot; + preferredSlot + &quot; has been cancelled and the slot released.&quot;" target="messageText" />
            <zeebe:output source="=notificationSent" target="cancelNotificationSent" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C2</bpmn:incoming>
        <bpmn:outgoing>Flow_C3</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_C3" sourceRef="Call_Cancel" targetRef="End_Cancelled" />
      <bpmn:endEvent id="End_Cancelled" name="Booking cancelled">
        <bpmn:incoming>Flow_C3</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_Cancel" name="cancel-booking">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="appointment-booking">
      <bpmndi:BPMNShape id="Start_Booking_di" bpmnElement="Start_Booking"><dc:Bounds x="180" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="158" y="225" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSlot_di" bpmnElement="Task_CheckSlot"><dc:Bounds x="270" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Slot_di" bpmnElement="Gateway_Slot" isMarkerVisible="true"><dc:Bounds x="425" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="423" y="232" width="54" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BookSlot_di" bpmnElement="Task_BookSlot"><dc:Bounds x="540" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Confirm_di" bpmnElement="Call_Confirm"><dc:Bounds x="690" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Appointment_di" bpmnElement="Task_Appointment"><dc:Bounds x="840" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Booked_di" bpmnElement="End_Booked"><dc:Bounds x="992" y="82" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="970" y="125" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SlotFull_di" bpmnElement="Call_SlotFull"><dc:Bounds x="540" y="260" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Full_di" bpmnElement="End_Full"><dc:Bounds x="692" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="680" y="325" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Cancel_di" bpmnElement="SubProcess_Cancel" isExpanded="true"><dc:Bounds x="300" y="400" width="560" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Cancel_di" bpmnElement="Start_Cancel"><dc:Bounds x="332" y="482" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="310" y="525" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Release_di" bpmnElement="Task_Release"><dc:Bounds x="420" y="462" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Cancel_di" bpmnElement="Call_Cancel"><dc:Bounds x="580" y="462" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled"><dc:Bounds x="732" y="482" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="710" y="525" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1"><di:waypoint x="216" y="200" /><di:waypoint x="270" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2"><di:waypoint x="370" y="200" /><di:waypoint x="425" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Avail_di" bpmnElement="Flow_Avail"><di:waypoint x="450" y="175" /><di:waypoint x="450" y="100" /><di:waypoint x="540" y="100" /><bpmndi:BPMNLabel><dc:Bounds x="470" y="82" width="58" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Full_di" bpmnElement="Flow_Full"><di:waypoint x="450" y="225" /><di:waypoint x="450" y="300" /><di:waypoint x="540" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="470" y="282" width="28" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1"><di:waypoint x="640" y="100" /><di:waypoint x="690" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_di" bpmnElement="Flow_B2"><di:waypoint x="790" y="100" /><di:waypoint x="840" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3_di" bpmnElement="Flow_B3"><di:waypoint x="940" y="100" /><di:waypoint x="992" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_F1_di" bpmnElement="Flow_F1"><di:waypoint x="640" y="300" /><di:waypoint x="692" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1"><di:waypoint x="368" y="500" /><di:waypoint x="420" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2"><di:waypoint x="520" y="500" /><di:waypoint x="580" y="500" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3"><di:waypoint x="680" y="500" /><di:waypoint x="732" y="500" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>